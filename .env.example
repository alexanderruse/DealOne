NESSIE_API_KEY=
NESSIE_BASE_URL=https://v2-prod-api.nessieisreal.com
NESSIE_CUSTOMER_ID=
NESSIE_CARD_ACCOUNT_ID=
NESSIE_MERCHANT_ID=
NESSIE_SETTLE_IMMEDIATELY=false
CANCEL_WINDOW_SECONDS=50
VULTR_REGISTRY_ID=369a6c53-fd50-4fe2-93d6-a151ec00c845
VULTR_REGION=ewr
