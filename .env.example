APP_ENV=development
APP_DOMAIN=localhost
DATABASE_URL=postgresql+psycopg://dealone:dealone@db:5432/dealone
SESSION_SECRET=local-development-session-key-change-before-deployment
DEMO_ADMIN_TOKEN=local-demo-admin
XAI_API_KEY=
XAI_MODEL=grok-4.20
RESEND_API_KEY=
RESEND_FROM_EMAIL=
STOREFRONT_URL=http://api:8000
